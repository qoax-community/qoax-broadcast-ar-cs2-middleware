{
  "name": "qoax-broadcast-ar-cs2-middleware",
  "version": "0.0.2",
  "description": "Middleware scripts for gathering CS2 HLAE data and forwarding it to UE5 Live Link.",
  "homepage": "https://github.com/qoax-community/qoax-broadcast-ar-cs2-middleware#readme",
  "bugs": {
    "url": "https://github.com/qoax-community/qoax-broadcast-ar-cs2-middleware/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qoax-community/qoax-broadcast-ar-cs2-middleware.git"
  },
  "license": "ISC",
  "author": "qoax-community",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/index.test.js",
    "package": "npm run build && pkg ."
  },
  "pkg": {
    "targets": [
      "node22-win-x64",
      "node22-macos-x64",
      "node22-linux-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.18.0",
    "@yao-pkg/pkg": "^6.22.0",
    "typescript": "^5.6.3"
  }
}
